# Copier ce fichier en .env puis renseigner la clé.
# Clé gratuite : https://console.mistral.ai (rubrique « API Keys »)
MISTRAL_API_KEY=

# Modèle Mistral utilisé par l'agent
LLM_MODEL=mistral-small-latest

# Si le compte Mistral est limité (erreur 429 « Rate limit exceeded »), indiquer ici
# le nombre de requêtes par minute autorisé : les appels sont alors espacés.
# LLM_REQUETES_PAR_MINUTE=2
